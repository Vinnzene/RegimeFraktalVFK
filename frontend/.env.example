# Salin menjadi .env.local lalu isi. .env.local TIDAK di-commit.

# --- Firebase (Project settings > General > Your apps > Web app > SDK config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Kunci service account (Project settings > Service accounts > Generate new
# private key). Path relatif terhadap root project; folder secrets/ diabaikan git.
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json
# Alternatif untuk hosting: isi JSON kunci langsung.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Telegram (token dari @BotFather; sama dengan backend/.env) ---
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Mode demo untuk sidang tanpa internet (hanya aktif di localhost) ---
DEMO_LOGIN=true
# String acak untuk menandatangani sesi demo. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Alamat backend FastAPI.
NEXT_PUBLIC_API_BASE=http://localhost:8000
