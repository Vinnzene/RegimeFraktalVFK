# Salin menjadi .env.local lalu isi. .env.local TIDAK di-commit.

# URL tempat dashboard dibuka. Mode demo hanya aktif bila ini localhost/127.0.0.1.
NEXTAUTH_URL=http://localhost:3000
# String acak panjang untuk menandatangani sesi. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true = tampilkan tombol "Masuk mode demo" (hanya berlaku di localhost), untuk sidang tanpa internet.
DEMO_LOGIN=true

# Alamat backend FastAPI.
NEXT_PUBLIC_API_BASE=http://localhost:8000
