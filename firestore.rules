rules_version = '2';
// Semua baca/tulis Firestore dilakukan server (Next.js API route dan backend
// Python) memakai Admin SDK, yang tidak terikat aturan ini. Akses langsung dari
// browser ditolak seluruhnya supaya chat ID pengguna tidak bisa dibaca orang lain.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
