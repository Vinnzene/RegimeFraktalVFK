# Salin menjadi backend/.env lalu isi. backend/.env TIDAK di-commit.

# Token dari @BotFather (perintah /newbot).
TELEGRAM_BOT_TOKEN=
# Username bot tanpa @, mis. regimefraktal_bot.
TELEGRAM_BOT_USERNAME=

# Kunci service account Firebase (Project settings > Service accounts >
# Generate new private key). Path relatif terhadap root project.
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json

# Jumlah window berturut-turut sebelum pergantian regime diumumkan (1 window = 4 bar).
NOTIFY_CONFIRM_WINDOWS=3

# Alamat dashboard, dipakai sebagai tautan di pesan notifikasi.
DASHBOARD_URL=http://rfraktal.my.id
